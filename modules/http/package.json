{
  "$schema": "https://json.schemastore.org/package",
  "name": "@msom/http",
  "version": "0.0.16",
  "description": "@msom/http",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "typings": "dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "msom",
    "http"
  ],
  "author": "msom",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "version": "node ../../scripts/version.js",
    "check": "tsc --noEmit",
    "build": "pnpm run clean && pnpm run check && vite build -c ../../vite.config.ts",
    "build::xbuild": "rimraf dist/types && pnpm run check && xbuild build",
    "release": "pnpm run build && pnpm run version --patch && pnpm publish --no-git-checks",
    "dev": "pnpm run --filter=./example dev",
    "server": "pnpm run --filter=./{example,e2,e3} server",
    "server2": "pnpm run build && pnpm run --filter=./{example,e2,e3} server"
  },
  "dependencies": {
    "@msom/common": "workspace:^",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  }
}
