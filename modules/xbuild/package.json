{
  "$schema": "https://json.schemastore.org/package",
  "name": "@msom/xbuild",
  "version": "1.0.6",
  "description": "@msom/xbuild",
  "main": "dist/index.js",
  "typings": "dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "bin": {
    "xbuild": "./bin/xbuild.js"
  },
  "keywords": [
    "msom",
    "xbuild"
  ],
  "author": "msom",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "version": "node ../../scripts/version.js",
    "check": "tsc --noEmit",
    "compile": "xbuild build -C",
    "build": "pnpm run clean && vite build -c ./vite.config.ts",
    "build::xbuild": "xbuild build",
    "build:ts": "xbuild build --dev",
    "release": "pnpm run build && pnpm run version --patch && pnpm publish --no-git-checks",
    "dev": "pnpm run compile && pnpm run --filter=./example dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@msom/common": "workspace:^",
    "@msom/component": "workspace:^",
    "@msom/dom": "workspace:^",
    "@msom/http": "workspace:^",
    "@msom/reaction": "workspace:^",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "autoprefixer": "^10.5.4",
    "body-parser": "^2.3.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "postcss": "^8.5.26",
    "rolldown": "^1.2.3",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "ts-node": "^10.9.2"
  }
}
