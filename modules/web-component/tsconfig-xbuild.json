{
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@msom/common": ["../common/src"],
      "@msom/common/*": ["../common/src/*"],
      "@msom/dom": ["../dom/src"],
      "@msom/dom/*": ["../dom/src/*"],
      "@msom/component": ["../component/src"],
      "@msom/component/*": ["../component/src/*"],
      "@msom/reaction": ["../reaction/src"],
      "@msom/reaction/*": ["../reaction/src/*"],
      "@msom/http": ["../http/src"],
      "@msom/http/*": ["../http/src/*"],
      "@msom/gallay": ["../gallay/src"],
      "@msom/gallay/*": ["../gallay/src/*"],
      "@msom/web-component": ["../web-component/src"],
      "@msom/web-component/*": ["../web-component/src/*"],
      "@msom/xbuild": ["../xbuild/src"],
      "@msom/xbuild/*": ["../xbuild/src/*"],
      "@msom/dom/jsx-runtime": ["../dom/src/jsx-runtime.ts"],
      "@msom/dom/jsx-dev-runtime": ["../dom/src/jsx-dev-runtime.ts"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-native",
    "jsxImportSource": "@msom/dom",
    "esModuleInterop": true,
    "allowUmdGlobalAccess": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false,
    "noEmitOnError": false,
    "noEmitHelpers": false,
    "importHelpers": false
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "../../modules/dom/jsx-runtime.d.ts",
    "../../modules/dom/jsx-dev-runtime.d.ts"
  ]
}
