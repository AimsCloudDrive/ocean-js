      "@msom/common": ["../common/dist/types/index.d.ts"],
      "@msom/component": ["../component/dist/types/index.d.ts"],
      "@msom/dom": ["../dom/dist/types/index.d.ts"],
      "@msom/dom/jsx-runtime": ["../dom/dist/types/jsx-runtime.d.ts"],
