{
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@msom/common": ["./modules/common/src"],
      "@msom/common/*": ["./modules/common/src/*"],
      "@msom/dom": ["./modules/dom/src"],
      "@msom/dom/*": ["./modules/dom/src/*"],
      "@msom/component": ["./modules/component/src"],
      "@msom/component/*": ["./modules/component/src/*"],
      "@msom/reaction": ["./modules/reaction/src"],
      "@msom/reaction/*": ["./modules/reaction/src/*"],
      "@msom/http": ["./modules/http/src"],
      "@msom/http/*": ["./modules/http/src/*"],
      "@msom/gallay": ["./modules/gallay/src"],
      "@msom/gallay/*": ["./modules/gallay/src/*"],
      "@msom/web-component": ["./modules/web-component/src"],
      "@msom/web-component/*": ["./modules/web-component/src/*"],
      "@msom/xbuild": ["./modules/xbuild/src"],
      "@msom/xbuild/*": ["./modules/xbuild/src/*"],
      "@msom/dom/jsx-runtime": ["./modules/dom/src/jsx-runtime.ts"],
      "@msom/dom/jsx-dev-runtime": ["./modules/dom/src/jsx-dev-runtime.ts"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-native",
    "jsxImportSource": "@msom/dom",
    "esModuleInterop": true,
    "allowUmdGlobalAccess": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false,
    "noEmitOnError": false,
    "noEmitHelpers": false,
    "importHelpers": false
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "../../modules/dom/jsx-runtime.d.ts",
    "../../modules/dom/jsx-dev-runtime.d.ts"
  ]
}
