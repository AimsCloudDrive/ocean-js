{
  "ts-node": {
    "swc": true
  },
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@msom/dom/jsx-runtime": ["./modules/dom/src/jsx-runtime"],
      "@msom/dom/jsx-dev-runtime": ["./modules/dom/src/jsx-dev-runtime"],
      "@msom/*": ["./modules/*/src"]
    },

    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "jsx": "react-native",
    "jsxImportSource": "@msom/dom",

    "declaration": true,
    "sourceMap": false,
    "declarationMap": false,
    "removeComments": false,
    "noEmit": true,
    "noEmitOnError": false,
    "noEmitHelpers": true,
    "importHelpers": true,

    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "strictBindCallApply": true,
    "noImplicitThis": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,

    "esModuleInterop": true,
    "allowUmdGlobalAccess": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true
  }
}
